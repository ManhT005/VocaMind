<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_toolbar_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/shell_screen_padding">

        <androidx.appcompat.widget.AppCompatImageButton style="@style/Widget.VocaMind.BackButton"
            android:id="@+id/personal_back_button"
            android:layout_width="@dimen/ui_touch_target"
            android:layout_height="@dimen/ui_touch_target"
            android:contentDescription="@string/personal_back"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_detail_back" />

        <TextView
            android:id="@+id/personal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.VocaMind.Section" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/personal_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/shell_screen_padding"
            android:paddingBottom="@dimen/shell_screen_padding" />
    </ScrollView>
</LinearLayout>
