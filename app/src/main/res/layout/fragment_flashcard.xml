<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/shell_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:minHeight="@dimen/ui_toolbar_height" android:paddingStart="@dimen/shell_screen_padding" android:paddingEnd="@dimen/shell_screen_padding">
        <androidx.appcompat.widget.AppCompatImageButton style="@style/Widget.VocaMind.BackButton" android:id="@+id/back"
            android:layout_width="@dimen/ui_touch_target" android:layout_height="@dimen/ui_touch_target"
            android:contentDescription="@string/attribution_back"
            app:srcCompat="@drawable/ic_detail_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/flashcard_title"
            android:textAppearance="@style/TextAppearance.VocaMind.Section"
            android:id="@+id/title"
            android:textColor="@color/shell_text_primary" />
        <TextView android:id="@+id/progress_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/shell_text_secondary" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:orientation="vertical">
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/session_progress"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
            android:importantForAccessibility="no" app:trackThickness="8dp" app:trackCornerRadius="4dp"
            app:trackColor="@color/detail_outline" app:indicatorColor="@color/shell_accent"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="12dp">

        <ProgressBar android:id="@+id/loading" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center" android:visibility="gone" />

        <LinearLayout android:id="@+id/state_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <ImageView android:id="@+id/completion_illustration" android:layout_width="64dp"
                android:layout_height="64dp" android:layout_marginBottom="12dp"
                android:src="@drawable/ui_hero_cards" android:importantForAccessibility="no"
                android:visibility="gone" />
            <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAlignment="center" android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/shell_text_primary" android:accessibilityLiveRegion="polite" />
            <com.google.android.material.button.MaterialButton android:id="@+id/retry"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target"
                android:layout_marginTop="16dp" android:text="@string/packs_retry" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/return_today"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_return_today"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:id="@+id/card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="220dp"
            android:clickable="true" android:focusable="true" android:visibility="gone"
            app:cardBackgroundColor="@color/detail_tint" app:cardCornerRadius="28dp"
            app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/detail_outline">
                <LinearLayout android:id="@+id/card_content"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
                    <TextView android:id="@+id/card_lemma" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAlignment="center" android:textAppearance="@style/TextAppearance.VocaMind.Prompt"
                        android:textColor="@color/shell_text_primary" />
                    <TextView android:id="@+id/card_pos" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/on_tint" android:background="@drawable/detail_pos_background" android:padding="8dp" />
                    <TextView android:id="@+id/card_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="24dp" android:textAlignment="center"
                        android:text="@string/flashcard_tap_hint" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/shell_text_secondary" />
                    <LinearLayout android:id="@+id/card_back" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="24dp" android:gravity="center_horizontal" android:orientation="vertical" android:visibility="gone">
                        <TextView android:id="@+id/card_ipa" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textAlignment="center" android:textAppearance="@style/TextAppearance.VocaMind.Caption"
                            android:textColor="@color/shell_text_secondary" />
                        <TextView android:id="@+id/card_meaning" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.VocaMind.DetailBody" android:textStyle="bold" />
                        <TextView android:id="@+id/card_example_en" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="20dp" android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.VocaMind.DetailBody"  android:background="@drawable/ui_row" android:padding="12dp" />
                        <TextView android:id="@+id/card_example_vi" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:textAlignment="center"
                            android:textAppearance="@style/TextAppearance.VocaMind.DetailBody"
                            android:textColor="@color/shell_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <TextView android:id="@+id/result_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="8dp" android:visibility="gone"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/shell_text_secondary" android:accessibilityLiveRegion="polite" />

    <TextView android:id="@+id/rating_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/ui_rating" android:visibility="gone"
        android:textAppearance="@style/TextAppearance.VocaMind.Section"/>
    <LinearLayout android:id="@+id/rating_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="12dp" android:paddingBottom="16dp" android:background="@color/detail_card_surface"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/rate_forgot"
            style="@style/Widget.VocaMind.OutlinedAction"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:singleLine="false"
            android:minHeight="56dp" android:minWidth="48dp" android:enabled="false"
            android:text="@string/flashcard_forgot" app:icon="@drawable/ic_ui_minus" app:cornerRadius="@dimen/ui_control_radius" />
        <com.google.android.material.button.MaterialButton android:id="@+id/rate_hard"
            style="@style/Widget.VocaMind.OutlinedAction"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:singleLine="false"
            android:minHeight="56dp" android:minWidth="48dp" android:enabled="false"
            android:text="@string/flashcard_hard" app:cornerRadius="@dimen/ui_control_radius" />
        <com.google.android.material.button.MaterialButton android:id="@+id/rate_remembered"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:singleLine="false"
            android:minHeight="56dp" android:minWidth="48dp" android:enabled="false"
            android:text="@string/flashcard_remembered" app:icon="@drawable/ic_ui_check" app:cornerRadius="@dimen/ui_control_radius" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
