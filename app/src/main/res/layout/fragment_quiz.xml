<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <Button android:id="@+id/quiz_back" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/quiz_back" />
        <TextView android:id="@+id/destination_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/quiz" style="@style/TextAppearance.VocaMind.Title" />
        <ProgressBar android:id="@+id/quiz_loading" android:layout_width="48dp" android:layout_height="48dp" />
        <TextView android:id="@+id/quiz_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:textSize="18sp" android:paddingTop="16dp" />
        <LinearLayout android:id="@+id/quiz_question" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/quiz_prompt" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="24sp" android:paddingTop="16dp" />
            <TextView android:id="@+id/quiz_context" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="16sp" android:paddingBottom="16dp" />
            <Button android:id="@+id/quiz_option_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" />
            <Button android:id="@+id/quiz_option_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" />
            <Button android:id="@+id/quiz_option_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" />
            <Button android:id="@+id/quiz_option_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" />
            <TextView android:id="@+id/quiz_feedback" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" android:textSize="18sp" android:padding="12dp" />
            <Button android:id="@+id/quiz_next" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/quiz_next" />
        </LinearLayout>
        <Button android:id="@+id/quiz_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
