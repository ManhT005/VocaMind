<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginBottom="@dimen/shell_item_spacing" android:padding="@dimen/ui_card_padding"
    android:background="@drawable/ui_row">
<TextView android:id="@+id/history_date" android:drawableStart="@drawable/ic_ui_quiz" android:drawablePadding="10dp" android:drawableTint="@color/shell_accent" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.VocaMind.Section" />
<TextView android:id="@+id/history_result" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.VocaMind.Body" />
</LinearLayout>
