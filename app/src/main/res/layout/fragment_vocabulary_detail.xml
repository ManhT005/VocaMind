<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/shell_screen_padding">
        <TextView android:id="@+id/route_message" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:id="@+id/detail_content" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/detail_lemma" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />
            <TextView android:id="@+id/detail_pos" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/detail_ipa" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/detail_meaning" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" />
            <TextView android:id="@+id/detail_example_en" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" />
            <TextView android:id="@+id/detail_example_vi" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/detail_save"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
            android:visibility="gone" android:text="@string/detail_save" />
        <com.google.android.material.button.MaterialButton android:id="@+id/detail_retry"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
            android:visibility="gone" android:text="@string/packs_retry" />
        <com.google.android.material.button.MaterialButton android:id="@+id/back"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/attribution_back" />
    </LinearLayout>
</ScrollView>
