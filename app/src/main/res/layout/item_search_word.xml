<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
    android:orientation="vertical" android:padding="12dp" android:clickable="true" android:focusable="true"
    android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/word_title" style="@style/TextAppearance.VocaMind.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" />
    <TextView android:id="@+id/word_meaning" style="@style/TextAppearance.VocaMind.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>