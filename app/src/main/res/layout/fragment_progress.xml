<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="@dimen/shell_screen_padding" android:paddingBottom="@dimen/shell_screen_padding">
 <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginBottom="@dimen/shell_item_spacing"
     android:minHeight="@dimen/ui_toolbar_height"
     android:gravity="center_vertical"
     android:orientation="horizontal">
  <TextView android:id="@+id/destination_title" style="@style/TextAppearance.VocaMind.Title" android:layout_width="0dp" android:layout_weight="1" android:accessibilityHeading="true" android:layout_height="wrap_content" android:text="@string/progress" />
  <com.google.android.material.button.MaterialButton style="@style/Widget.VocaMind.TextAction" android:id="@+id/progress_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target" android:text="@string/progress_refresh" />
 </LinearLayout>
 <LinearLayout android:id="@+id/progress_loading" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <ProgressBar android:layout_width="48dp" android:layout_height="48dp" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/progress_loading" android:accessibilityLiveRegion="polite" />
 </LinearLayout>
 <LinearLayout android:id="@+id/progress_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/progress_error" android:accessibilityLiveRegion="polite" />
  <com.google.android.material.button.MaterialButton android:id="@+id/progress_retry" style="@style/Widget.VocaMind.TextAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target" android:text="@string/progress_retry" />
 </LinearLayout>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/progress_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
</LinearLayout>
