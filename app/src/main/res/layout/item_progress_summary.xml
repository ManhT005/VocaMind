<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/ui_hero" android:orientation="vertical" android:padding="@dimen/ui_hero_padding">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.VocaMind.Section" android:text="@string/ui_learned" android:drawableStart="@drawable/ic_ui_progress" android:drawablePadding="10dp" android:drawableTint="@color/shell_accent"/>
    <TextView android:id="@+id/total_learned" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.VocaMind.Title" android:textSize="44sp"/>
    <TextView android:id="@+id/progress_counts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.VocaMind.Body" />
    <TextView android:id="@+id/progress_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.VocaMind.Body" android:text="@string/progress_empty" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginTop="12dp" android:padding="@dimen/ui_card_padding"
    android:background="@drawable/ui_row">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityHeading="true" android:textAppearance="@style/TextAppearance.VocaMind.Section" android:text="@string/learning_statistics"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/learning_period"
        style="@style/Widget.VocaMind.OutlinedAction" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target" app:icon="@drawable/ic_ui_calendar" app:cornerRadius="@dimen/ui_control_radius" android:text="@string/learning_today" />
    <LinearLayout android:id="@+id/learning_totals" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:accessibilityLiveRegion="polite">
        <TextView android:id="@+id/learning_metric_new" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/ui_icon_tile" android:padding="12dp" android:drawableTint="@color/shell_accent"
            android:drawableStart="@drawable/ic_ui_spark" android:drawablePadding="8dp"
            android:textAppearance="@style/TextAppearance.VocaMind.Body" />
        <TextView android:id="@+id/learning_metric_reviews" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/ui_icon_tile" android:padding="12dp" android:drawableTint="@color/shell_accent"
            android:drawableStart="@drawable/ic_ui_learn" android:drawablePadding="8dp"
            android:textAppearance="@style/TextAppearance.VocaMind.Body" />
        <TextView android:id="@+id/learning_metric_quizzes" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/ui_icon_tile" android:padding="12dp" android:drawableTint="@color/shell_accent"
            android:drawableStart="@drawable/ic_ui_quiz" android:drawablePadding="8dp"
            android:textAppearance="@style/TextAppearance.VocaMind.Body" />
        <TextView android:id="@+id/learning_metric_accuracy" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/ui_icon_tile" android:padding="12dp" android:drawableTint="@color/shell_accent"
            android:drawableStart="@drawable/ic_ui_check" android:drawablePadding="8dp"
            android:textAppearance="@style/TextAppearance.VocaMind.Body" />
    </LinearLayout>
    </LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/ui_row"
    android:orientation="vertical"
    android:padding="@dimen/ui_card_padding">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityHeading="true" android:textAppearance="@style/TextAppearance.VocaMind.Section" android:text="@string/learning_achievements"/>
    <TextView android:id="@+id/learning_streak" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.VocaMind.Body"/>
    <TextView android:id="@+id/learning_goal" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.VocaMind.Body"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/learning_goal_bar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:importantForAccessibility="no" app:trackThickness="8dp" app:trackCornerRadius="4dp"
        app:trackColor="@color/detail_outline" />
    </LinearLayout>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/ui_row"
    android:orientation="vertical"
    android:padding="@dimen/ui_card_padding">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityHeading="true" android:textAppearance="@style/TextAppearance.VocaMind.Section" android:text="@string/learning_review_history"/>
    <TextView android:id="@+id/learning_latest_review" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.VocaMind.Body"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/learning_open_reviews"
        style="@style/Widget.VocaMind.OutlinedAction" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="@dimen/ui_touch_target" app:cornerRadius="@dimen/ui_control_radius" android:text="@string/learning_open_reviews" />
</LinearLayout>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/ui_row"
    android:orientation="vertical"
    android:padding="@dimen/ui_card_padding">
    <TextView android:id="@+id/box_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:textAppearance="@style/TextAppearance.VocaMind.Section" android:text="@string/progress_boxes" />
<TextView android:id="@+id/box_0" android:layout_marginTop="6dp" android:background="@drawable/ui_icon_tile" android:paddingHorizontal="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:textAppearance="@style/TextAppearance.VocaMind.Body" />
<TextView android:id="@+id/box_1" android:layout_marginTop="6dp" android:background="@drawable/ui_icon_tile" android:paddingHorizontal="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:textAppearance="@style/TextAppearance.VocaMind.Body" />
<TextView android:id="@+id/box_2" android:layout_marginTop="6dp" android:background="@drawable/ui_icon_tile" android:paddingHorizontal="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:textAppearance="@style/TextAppearance.VocaMind.Body" />
<TextView android:id="@+id/box_3" android:layout_marginTop="6dp" android:background="@drawable/ui_icon_tile" android:paddingHorizontal="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:textAppearance="@style/TextAppearance.VocaMind.Body" />
<TextView android:id="@+id/box_4" android:layout_marginTop="6dp" android:background="@drawable/ui_icon_tile" android:paddingHorizontal="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:textAppearance="@style/TextAppearance.VocaMind.Body" />
<TextView android:id="@+id/box_5" android:layout_marginTop="6dp" android:background="@drawable/ui_icon_tile" android:paddingHorizontal="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:textAppearance="@style/TextAppearance.VocaMind.Body" />
</LinearLayout>
<TextView android:accessibilityHeading="true" android:id="@+id/history_heading" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:textAppearance="@style/TextAppearance.VocaMind.Section" android:text="@string/progress_history" />
<TextView android:id="@+id/history_empty" android:background="@drawable/ui_row" android:paddingHorizontal="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:textAppearance="@style/TextAppearance.VocaMind.Body" android:text="@string/progress_history_empty" />
</LinearLayout>
